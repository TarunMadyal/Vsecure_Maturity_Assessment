# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vsecure_iam

# ---------------------------------------------------------------------------
# Email (Nodemailer). Lead + completion notifications are sent to ADMIN_EMAIL.
#
# If SMTP_USER is left EMPTY, emails are NOT sent - they are printed to the
# server console instead (fine for local testing).
#
# To actually receive emails at ADMIN_EMAIL, fill in SMTP settings below.
# Easiest option is a Gmail account with an "App Password":
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#      (choose "Mail" -> "Other", name it "vSecure", copy the 16-char code)
#   3. Set SMTP_USER to that Gmail address and SMTP_PASS to the app password
#      (remove the spaces from the 16-char code).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="vSecure Assessments <no-reply@vsecure.ai>"

# Where new-lead + completion notifications are sent.
ADMIN_EMAIL=tarunmadyal@gmail.com
# Password for /admin dashboard and /api/admin/* (HTTP Basic, user "admin")
ADMIN_PASSWORD=

SESSION_SECRET=
# Public URL used in emails and links
BASE_URL=https://assess.vsecure.ai

PORT=3001

# Optional: path to a Chrome/Chromium binary for Puppeteer PDF generation.
# Leave empty to use the Chromium bundled with Puppeteer.
PUPPETEER_EXECUTABLE_PATH=
# Optional: URL Puppeteer renders for the PDF (defaults to http://localhost:PORT)
PDF_RENDER_URL=
