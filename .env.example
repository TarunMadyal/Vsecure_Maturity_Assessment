# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vsecure_iam

# SMTP (Nodemailer). Leave SMTP_USER empty to log emails to console (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="vSecure Assessments <no-reply@vsecure.ai>"

# Where lead + completion notifications are sent
ADMIN_EMAIL=vijay@vsecure.ai
# Password for /admin dashboard and /api/admin/* (HTTP Basic, user "admin")
ADMIN_PASSWORD=

SESSION_SECRET=
# Public URL used in emails and links
BASE_URL=https://assess.vsecure.ai

PORT=3001

# Optional: path to a Chrome/Chromium binary for Puppeteer PDF generation.
# Leave empty to use the Chromium bundled with Puppeteer.
PUPPETEER_EXECUTABLE_PATH=
# Optional: URL Puppeteer renders for the PDF (defaults to http://localhost:PORT)
PDF_RENDER_URL=
